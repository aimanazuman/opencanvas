# OpenCanvas production settings (docker-compose.prod.yml).
# Copy this file to .env.prod and fill in the values:
#   cp .env.prod.example .env.prod
# This file holds NON-secret settings only. Passwords and keys are separate files in ~/secrets, see docs/DEPLOYMENT.md.
# .env.prod is ignored by git. Never commit it.

# ---- Required ---------------------------------------------------------------------------------------------------

# The public address of the site, without https:// (for example opencanvas.example.com).
DOMAIN=opencanvas.example.com

# The mail account used to send emails (verification, password reset). The password for it is the secret file
# ~/secrets/smtp_password.txt.
SMTP_USER=your-mail-account@example.com

# ---- Admin page protection --------------------------------------------------------------------------------------

# Who may open https://<DOMAIN>/admin (the Django admin). A comma separated list of addresses or ranges, for example
#   OPENCANVAS_ADMIN_ALLOWED_IPS=203.0.113.7/32,198.51.100.0/24
# Empty (or left out) means CLOSED: nobody can open /admin from the internet. Fill it with your own public IP address
# when you need the admin, then run: docker compose --env-file .env.prod -f docker-compose.prod.yml up -d
OPENCANVAS_ADMIN_ALLOWED_IPS=

# ---- Optional (the defaults are shown) ------------------------------------------------------------------------

# Mail server. The default is Gmail on port 587 with STARTTLS.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587

# Where the database files, uploads and static files live on the VPS (plain folders, see docs/DEPLOYMENT.md).
# OPENCANVAS_DATA_DIR=/srv/opencanvas

# Where the secret files live (outside the repository).
# SECRETS_DIR=/home/youruser/secrets

# Request limits per visitor, requests per second (Traefik). The visitor is identified by Cloudflare's CF-Connecting-IP.
# Many students can share one network address (a campus), so raise these before lowering them.
# OPENCANVAS_RL_AVERAGE=20
# OPENCANVAS_RL_BURST=50
# Stricter limit for sign-in, registration, password reset and the Django admin.
# OPENCANVAS_RL_AUTH_AVERAGE=5
# OPENCANVAS_RL_AUTH_BURST=10

# How the backend finds the real visitor address (used for logs, login lockout and throttling).
# TRUSTED_PROXY_COUNT is the number of proxies in front of the backend that you trust: 1 = only Traefik.
# TRUST_CLOUDFLARE_HEADER=True makes it believe the CF-Connecting-IP header. Turn it on ONLY if nobody can reach the
# server except through Cloudflare (firewall allows only Cloudflare's address ranges on ports 80 and 443).
# TRUSTED_PROXY_COUNT=1
# TRUST_CLOUDFLARE_HEADER=False

# Gunicorn (the Python web server) tuning for a small VPS.
# GUNICORN_WORKERS=2
# GUNICORN_THREADS=4
# Which sources may set X-Forwarded-* headers. Default is the whole Docker private range 172.16.0.0/12. For a tighter
# value use the subnet of the proxy network: docker network inspect proxy --format '{{(index .IPAM.Config 0).Subnet}}'
# GUNICORN_FORWARDED_ALLOW_IPS=172.16.0.0/12

# ---- Only for the optional standalone Traefik (docker-compose.traefik.yml) ------------------------------------

# NOT needed on a VPS that already has a shared Traefik. Email for Let's Encrypt expiry notices.
# ACME_EMAIL=your-email@example.com
