# DEV ONLY. Development only (docker-compose.yml). These are throwaway values for a local database that holds no real
# data. They are not secrets and must never be reused anywhere else, and no production setting may ever use them.
# Optional: without this file the compose file uses the same kind of default. Copy to .env.dev and run:
#   docker compose --env-file .env.dev up
OC_DEV_DB_ROOT_PASSWORD=dev-only-root-not-a-secret

# DEV ONLY demo accounts. On every backend start, seed_dev_users creates or updates them (role, verified email, and
# the password when it changed). Refused unless DEBUG is on. Clear a role's three values to skip that role; all three
# values of a role must be set together. Never reuse these passwords.
# Admin access info
DEV_SEED_ADMIN_USERNAME=dev_admin
DEV_SEED_ADMIN_EMAIL=dev-admin@example.test
DEV_SEED_ADMIN_PASSWORD=DemoAdmin-Pass-2719!
# Lecturer access info
DEV_SEED_LECTURER_USERNAME=dev_lecturer
DEV_SEED_LECTURER_EMAIL=dev-lecturer@example.test
DEV_SEED_LECTURER_PASSWORD=DemoLecturer-Pass-4826!
# Student access info
DEV_SEED_STUDENT_USERNAME=dev_student
DEV_SEED_STUDENT_EMAIL=dev-student@example.test
DEV_SEED_STUDENT_PASSWORD=DemoStudent-Pass-9053!
